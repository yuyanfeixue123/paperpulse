# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 生成密钥：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# 必填（生产）：session 与 HMAC token 签名密钥
PAPERPULSE_SECRET_KEY=

# 必填（生产）：Fernet 凭据加密密钥。变更后已加密的 LLM Key / 邮件凭据需重新配置。
PAPERPULSE_ENCRYPTION_KEY=

# 可选覆盖
# PAPERPULSE_RUN_MODE=lite
# PAPERPULSE_WEB__HOST=127.0.0.1
# PAPERPULSE_WEB__PORT=8000
# PAPERPULSE_DB__URL=sqlite:///data/paperpulse.db
# PAPERPULSE_SOURCES__CONTACT_EMAIL=you@example.com

# ---------------------------------------------------------------- 危险项
# PAPERPULSE_ENV 决定是否允许「弱密钥回退」。
#
#   development / test —— 允许在未配置密钥时使用内置弱密钥（仅供本地调试）
#   其他任何值（含不设置）—— 一律按生产处理：缺密钥直接拒绝启动
#
# ⚠️ 生产环境**不要设置这一项**。误设为 development 会让应用在缺失
# PAPERPULSE_SECRET_KEY 时静默使用公开的弱密钥，会话与 HMAC token 可被
# 任意伪造。后台「系统自检」会把该状态标为异常。
# PAPERPULSE_ENV=development

# ---------------------------------------------------------------- 反代信任
# 只有当直连对端命中此列表时，才采信 X-Forwarded-For（用于限流分桶）。
# 留空则只信任回环地址。uvicorn 端口若直接暴露公网，攻击者可伪造该头
# 绕过限流 —— 务必经 Caddy / Nginx 访问。
# 多个用逗号分隔，支持 CIDR：
# PAPERPULSE_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# ---------------------------------------------------------------- 迁移用
# 指定 alembic 迁移的目标库。留空则用应用配置里的地址。
# 只有在「临时库上验证迁移」这类场景才需要设置。
# PAPERPULSE_MIGRATION_DB_URL=sqlite:///data/migration_check.db

